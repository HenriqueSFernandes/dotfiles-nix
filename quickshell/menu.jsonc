{
  // Minimal Ricky menu
  "apps": { "icon": "󰀻", "label": "Apps", "provider": "apps" },
  "bookmarks": { "icon": "󰃢", "label": "Bookmarks" },
  "clipboard": { "icon": "󰅌", "label": "Clipboard", "provider": "clipboard" },
  "snippets": { "icon": "󰅍", "label": "Snippets" },

  "snippets.email": { "icon": "󰇮", "label": "Email", "action": "printf '%s' 'henriquesardofernandes@gmail.com' | wl-copy" },
  "snippets.phone": { "icon": "󰏲", "label": "Phone", "action": "printf '%s' '926256277' | wl-copy" },
  "snippets.address": { "icon": "󰤇", "label": "Address", "action": "printf '%s' 'Rua do Cambarnal n8' | wl-copy" },
  "trigger": { "icon": "󱓞", "label": "Trigger" },
  "windows": { "icon": "", "label": "Windows", "provider": "windows" },
  "processes": { "icon": "󰓅", "label": "Processes", "provider": "processes" },
  "system": { "icon": "", "label": "System" },
  "update": { "icon": "", "label": "Update" },

  "bookmarks.github": { "icon": "󰊤", "label": "GitHub", "action": "xdg-open 'https://github.com'" },
  "bookmarks.nixpkgs": { "icon": "", "label": "Nix Packages", "action": "xdg-open 'https://search.nixos.org/packages'" },
  "bookmarks.protonmail": { "icon": "󰇮", "label": "Proton Mail", "action": "xdg-open 'https://mail.proton.me'" },
  "bookmarks.youtube": { "icon": "󰗃", "label": "YouTube", "action": "xdg-open 'https://youtube.com'" },

  "trigger.emoji": { "icon": "", "label": "Emoji", "provider": "emoji" },
  "trigger.capture": { "icon": "", "label": "Capture" },
  "trigger.capture.screenshot": { "icon": "", "label": "Screenshot", "action": "hyprshot -m region" },
  "trigger.capture.window": { "icon": "", "label": "Window Screenshot", "action": "hyprshot -m window" },
  "trigger.capture.screenrecord": { "icon": "", "label": "Screenrecord", "action": "echo 'screenrecord not configured'" },
  "trigger.colorpicker": { "icon": "󰉻", "label": "Color Picker", "action": "hyprpicker -a" },
  "trigger.toggle": { "icon": "󰔎", "label": "Toggle" },
  "trigger.toggle.nightlight": { "icon": "󰔎", "label": "Nightlight", "action": "pkill hyprsunset || hyprsunset" },
  "trigger.toggle.stayawake": { "icon": "󰅶", "label": "Stay Awake", "action": "caffeine" },
  "trigger.toggle.screensaver": { "icon": "󱄄", "label": "Screensaver", "action": "hyprlock" },

  "system.lock": { "icon": "", "label": "Lock", "action": "hyprlock" },
  "system.logout": { "icon": "󰍃", "label": "Logout", "action": "loginctl terminate-user $USER" },
  "system.reboot": { "icon": "󰜉", "label": "Reboot", "action": "systemctl reboot" },
  "system.poweroff": { "icon": "󰐥", "label": "Power Off", "action": "systemctl poweroff" },
  "system.suspend": { "icon": "󰒲", "label": "Suspend", "action": "systemctl suspend" },

  "update.system": { "icon": "", "label": "System Update", "action": "ghostty -e bash -lc 'nh os switch'" },
  "update.flake": { "icon": "❄", "label": "Update Flake", "action": "ghostty -e bash -lc 'nh os switch --update'" }
}
